# cordis.patch.yml.example — DSH 接入 agentbridge-dsh 的 MCP 配置示例
#
# 适用：DSH 0.1.x / 0.2.x（已在 0.2.1-rc.2 上实测）。DSH 当前有两类常见宿主，
# 配置落点不同：
#
#   A. 桌面 App（DeepSeek Harness，profile = desktop，2026-10 起是主要形态）
#        %USERPROFILE%\.dsh\profiles\desktop\cordis.patch.yml
#
#   B. CLI/浏览器 web 版（`dsh web` 或 `abg dsh --pair` 拉起的实例，profile = web）
#        %USERPROFILE%\.dsh\profiles\web\cordis.patch.yml
#
#   C. 想让两个 profile 共用一份配置（推荐）——home 层 patch：
#        %USERPROFILE%\.dsh\cordis.patch.yml
#      该文件对 web / desktop / 其它 profile 都生效；profile 自己的 patch 优先级更高。
#
# 语义说明（0.2.x）：这份文件是 cordis 的“覆盖/插入”层，根节点是一个 YAML 数组。
#   - 新增插件条目必须用 `- insert:` 包一层；直接写 `- id: ...` 会被当成“覆盖已有
#     条目”，匹配不到时只打 stderr warning 后丢弃。
#   - 文件为空或只有注释会导致启动失败；不想启用时写 `[]`。
#   - 保存后 live profile 通常会 HMR 热生效；没有生效就重启宿主。
#
# 用法：
#   1. 先确认 agentbridge-dsh 的 MCP server 已经在跑：
#        abg dsh --pair <NAME>        # 一键：MCP + DSH(自动识别桌面版/web) + chromium 窗口
#      或只起适配器：
#        abg dsh mcp --mode channel --http-port 8765
#   2. 把下面这段（按需去掉注释）追加/合并到上面选定的 patch 文件。
#   3. 生效后 DSH 会话工具列表出现：
#        mcp__abg__send_message   给 codex/claude 对端发消息并等待这一轮回复
#        mcp__abg__get_messages   取对端发来的、还没被消费的消息
#        mcp__abg__pair_status    查 agent-bridge daemon / app-server 是否可达
#        mcp__abg__claude_send    跑一次性的 `claude -p` 提示并拿到 Claude 的回复
#                                 （readonly: true 用 --permission-mode plan 只读；
#                                   continue 默认 true，延续 cwd 里最近一次会话）

- insert:
    - id: mcp-agentbridge
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: abg
        transport: streamable-http
        url: http://127.0.0.1:8765/mcp
        # DSH 的 dsh-mcp-client 默认 toolCallTimeoutMs=60000，小于适配器
        # send_message 默认 180s / claude_send 默认 300s 的等待时间；不放开的话
        # 长回合会被 DSH 侧先判超时。该字段在 0.2.x 支持；0.1.x 不认识时删掉此行。
        toolCallTimeoutMs: 300000
